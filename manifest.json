{
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "pt_BR",
  "version": "0.0.3",
  "incognito": "split",
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  },
  "permissions": ["history", "favicon"],
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "manifest_version": 3
}
